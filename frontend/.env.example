# ML prediction API (Flask sidecar in ../ml_training/predict_api.py, port 5001).
# NOTE: services/mlPredictionService.js reads this as a bare `process.env.ML_API_URL`.
# Expo (SDK 54) only inlines EXPO_PUBLIC_*-prefixed vars into the client bundle, so this
# plain-named var is not actually picked up by the running app yet — kept here for parity
# with the fallback default already in code, not because it's wired up end-to-end.
ML_API_URL=http://localhost:5001
